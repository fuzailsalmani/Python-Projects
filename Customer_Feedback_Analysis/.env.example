# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Required for the email-generation step (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Optional: pin a specific Gemini model (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Kaggle credentials (needed for the dataset download if you are not already
# logged in via kagglehub / ~/.kaggle/kaggle.json). Create a token at
# https://www.kaggle.com/settings -> API.
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_key
# Newer Kaggle accounts may use a single API token instead:
# KAGGLE_API_TOKEN=your_kaggle_api_token
